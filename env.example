# Personal Disk 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 应用环境 (development|test|production)
APP_ENV=development

# 数据库配置
DB_DRIVER=sqlite
DB_PATH=data/personal_disk.db
# 使用 MySQL 时取消下面配置并设置 DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=personal_disk

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# 文件上传配置
UPLOAD_DIRECTORY=storage
UPLOAD_MAX_SIZE=536870912

# 日志配置
LOG_LEVEL=info
LOG_FILE=app.log

# Docker 配置（用于 docker-compose）
APP_PORT=8080
